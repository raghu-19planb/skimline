{
  "name": "skimline-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm test && npm run format:check"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "prettier": "^3.10.1",
    "typescript": "~7.0.2",
    "vite": "^8.4.0"
  },
  "dependencies": {
    "maplibre-gl": "^5.24.1"
  }
}
